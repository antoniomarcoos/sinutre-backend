# Banco de dados SQLite (arquivo local em prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Servidor
PORT=3333

# GitHub OAuth (crie um OAuth App em https://github.com/settings/developers)
GITHUB_CLIENT_ID="seu-id-do-github-aqui"
GITHUB_CLIENT_SECRET="seu-secret-do-github-aqui"
GITHUB_CALLBACK_URL="http://localhost:3333/auth/github/callback"

# Google OAuth
GOOGLE_CLIENT_ID="seu-id-do-google-aqui"
GOOGLE_CLIENT_SECRET="seu-secret-do-google-aqui"
GOOGLE_CALLBACK_URL="http://localhost:3333/auth/google/callback"

# JWT
JWT_SECRET="troque-esta-string-em-producao"

# Frontend (para redirect após login)
FRONTEND_URL="http://localhost:5173"